# Keep credentials and local secrets out of IBM Bob's tools (gitignore syntax).
.env
.env.*
!.env.example
*.pem
*.key
*.p12
*.pfx
*credential*
*secret*
.aws/
.azure/
.kube/
.config/gcloud/

# Local tooling and bulky artefacts Bob does not need
node_modules/
apps/web/dist/
.venv/
venv/
__pycache__/
.pytest_cache/
.claude/
.lock*/
